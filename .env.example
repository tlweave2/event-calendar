# ─── Required ──────────────────────────────────────────────────────────────

# Postgres connection string used by the app at runtime (pooled is fine).
DATABASE_URL="postgresql://user:password@localhost:5432/event_calendar"
# Direct (unpooled) connection used for migrations. Falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/event_calendar"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Public origin of the app. Used for session cookies and every link in an
# outgoing email (invites, password resets, verification).
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Without these, invitation and password-reset links are only printed to the
# server log. Fine locally; a production deployment needs them, or invited
# users and locked-out customers have no way in.

RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Require a confirmed email address before sign-in. Leave unset until email
# delivery is verified working — turning it on without a mail provider locks
# every new account out.
REQUIRE_EMAIL_VERIFICATION="false"

# ─── Billing (Stripe) ──────────────────────────────────────────────────────
# Billing endpoints return a clear error until STRIPE_SECRET_KEY is set; the
# rest of the app runs fine without it.

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# ─── Image uploads (S3 or Cloudflare R2) ───────────────────────────────────
# Either the AWS_* set or the R2_* set. Uploads are disabled without them.

AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_PUBLIC_URL=""
# AWS_ENDPOINT_URL=""

# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# ─── AI flyer scanning (optional, Pro feature) ─────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Operations ────────────────────────────────────────────────────────────

# Bearer token for scheduled jobs (GET /api/demo/cleanup).
CRON_SECRET=""
# Shared secret for POST /api/superadmin/set-plan. Sent in the
# x-superadmin-secret header — never in a query string.
SUPERADMIN_SECRET=""

# Password given to the accounts created by `prisma db seed` (dev only).
SEED_ADMIN_PASSWORD="changeme123"
